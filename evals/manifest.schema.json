{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulinoTech1/Steganography/blob/main/evals/manifest.schema.json",
  "title": "stegdetect evaluation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "label_version", "sources", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "label_version": {"type": "string", "minLength": 1},
    "sources": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "provenance", "license", "independent_source"],
      "properties": {
        "kind": {"enum": ["project_synthetic", "public_licensed", "consented_private"]},
        "provenance": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "independent_source": {"type": "boolean"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "source_group", "split", "primary_stratum", "tags",
                   "carrier_labels", "intent_label", "expected_actions", "transform_constraints",
                   "expected_legacy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "text": {"type": "string"},
        "source_group": {"type": "string", "minLength": 1},
        "split": {"enum": ["development", "holdout"]},
        "primary_stratum": {
          "enum": ["latin_prose", "rtl_direction", "joining_control", "indic", "cjk_variation",
                   "emoji", "mixed_script", "code_config", "science_math", "security_quote"]
        },
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "carrier_labels": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["ZERO_WIDTH", "BIDI_OVERRIDE", "MIXED_SCRIPT", "TAG_CHARACTER",
                            "INVISIBLE_FORMAT", "SUSPICIOUS_WHITESPACE"]}
        },
        "intent_label": {"enum": ["benign", "constructed_attack", "unknown"]},
        "expected_actions": {
          "type": "object", "required": ["balanced", "legacy_verdict"],
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"enum": ["allow", "review", "block"]}
        },
        "transform_constraints": {
          "type": "object", "additionalProperties": false,
          "required": ["preserve_unchanged", "legacy_changed"],
          "properties": {
            "preserve_unchanged": {"const": true},
            "legacy_changed": {"type": "boolean"}
          }
        },
        "expected_legacy": {
          "type": "object", "additionalProperties": false,
          "required": ["verdict", "categories", "finding_count", "sanitized"],
          "properties": {
            "verdict": {"enum": ["clean", "suspicious", "malicious"]},
            "categories": {
              "type": "array", "uniqueItems": true,
              "items": {"enum": ["ZERO_WIDTH", "BIDI_OVERRIDE", "MIXED_SCRIPT", "TAG_CHARACTER",
                                "INVISIBLE_FORMAT", "SUSPICIOUS_WHITESPACE"]}
            },
            "finding_count": {"type": "integer", "minimum": 0},
            "sanitized": {"type": "string"}
          }
        }
      }
    }
  }
}
